    startBtn.addEventListener("click", () => {
      const rawName = studentNameInput.value.trim();
      const rawClass = studentClassInput.value.trim();
      if (!rawName) {
        alert("Silakan masukkan Nama Lengkap Peserta terlebih dahulu.");
        studentNameInput.focus();
        return;
      }

      studentName = rawName;
      studentClass = rawClass || "IX";
      showScreen(quizScreen);
      document.getElementById("headerBadge").textContent = `${studentName} (${studentClass})`;

      currentIdx = 0;
      score = 0;
      userAnswers = [];
      timeRemaining = TOTAL_TIME;
      document.getElementById("liveScore").textContent = "0";

      startTimer();
      renderQuestion();
    });

    function startTimer() {
      clearInterval(timerInterval);
      updateTimerUI();
      timerInterval = setInterval(() => {
        timeRemaining--;
        updateTimerUI();
        if (timeRemaining <= 0) {
          clearInterval(timerInterval);
          finishQuiz();
        }
      }, 1000);
    }

    function updateTimerUI() {
      const mins = String(Math.floor(timeRemaining / 60)).padStart(2, "0");
      const secs = String(timeRemaining % 60).padStart(2, "0");
      const timerEl = document.getElementById("timerDisplay");
      timerEl.textContent = `${mins}:${secs}`;
      if (timeRemaining <= 180) {
        timerEl.classList.add("warning");
      } else {
        timerEl.classList.remove("warning");
      }
    }

    function renderQuestion() {
      const q = questions[currentIdx];
      const levelBadge = document.getElementById("levelBadge");
      levelBadge.textContent = q.level;
      levelBadge.className = `level-tag ${q.levelClass}`;

      document.getElementById("questionTopic").textContent = `Topik: ${q.topic}`;
      document.getElementById("questionCounter").textContent = `Soal ${currentIdx + 1} dari ${questions.length}`;
      document.getElementById("progressFill").style.width = `${(currentIdx / questions.length) * 100}%`;
      document.getElementById("questionText").textContent = `${currentIdx + 1}. ${q.question}`;
      document.getElementById("illustrationBox").innerHTML = q.svg;

      const optionsContainer = document.getElementById("optionsContainer");
      optionsContainer.innerHTML = "";

      const letters = ["A", "B", "C", "D"];
      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerHTML = `<span class="option-letter">${letters[idx]}</span><span>${opt}</span>`;
        btn.addEventListener("click", () => selectOption(idx));
        optionsContainer.appendChild(btn);
      });

      document.getElementById("explanationBox").style.display = "none";
      nextBtn.disabled = true;
      nextBtn.textContent = currentIdx === questions.length - 1 ? "Selesai & Simpan Nilai ✓" : "Soal Berikutnya →";
    }

    function selectOption(selectedIndex) {
      const q = questions[currentIdx];
      const optionButtons = document.querySelectorAll(".option-btn");
      const isCorrect = selectedIndex === q.answer;

      optionButtons.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === q.answer) {
          btn.classList.add("correct");
        } else if (idx === selectedIndex && !isCorrect) {
          btn.classList.add("wrong");
        }
      });

      if (isCorrect) {
        score += 5; // 20 soal x 5 poin = 100
        document.getElementById("liveScore").textContent = score;
      }

      userAnswers.push({
        level: q.level,
        question: q.question,
        selected: q.options[selectedIndex],
        correct: q.options[q.answer],
        isCorrect: isCorrect,
        explanation: q.explanation
      });

      document.getElementById("explanationText").textContent = q.explanation;
      document.getElementById("explanationBox").style.display = "block";
      document.getElementById("progressFill").style.width = `${((currentIdx + 1) / questions.length) * 100}%`;
      nextBtn.disabled = false;
    }

