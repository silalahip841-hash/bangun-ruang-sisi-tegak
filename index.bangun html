    function getSavedResults() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch (e) {
        return [];
      }
    }

    function saveParticipantResult(record) {
      const list = getSavedResults();
      list.push(record);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      updateParticipantCountBadge();
    }

    function updateParticipantCountBadge() {
      const count = getSavedResults().length;
      document.getElementById("participantCountBadge").textContent = count;
