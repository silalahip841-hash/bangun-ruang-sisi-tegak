<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kuis Matematika Kelas 9: Bangun Ruang Sisi Tegak (BRST)</title>
  <style>
    :root {
      --primary: #1e40af;
      --primary-light: #3b82f6;
      --secondary: #0f172a;
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #1e293b;
      --muted: #64748b;
      --success: #15803d;
      --success-bg: #dcfce7;
      --danger: #b91c1c;
      --danger-bg: #fee2e2;
      --border: #e2e8f0;
      --easy-bg: #dcfce7;
      --easy-text: #166534;
      --med-bg: #fef9c3;
      --med-text: #854d0e;
      --ctx-bg: #e0f2fe;
      --ctx-text: #075985;
      --hots-bg: #f3e8ff;
      --hots-text: #6b21a8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #dbeafe 0%, #f8fafc 50%, #e0e7ff 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 24px 16px;
    }

    .app-container {
      width: 100%;
      max-width: 920px;
      background: var(--card);
      border-radius: 20px;
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .header {
      background: linear-gradient(120deg, var(--primary), var(--primary-light));
      color: white;
      padding: 22px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .header h1 {
      font-size: 1.32rem;
      font-weight: 700;
    }

    .header p {
      font-size: 0.86rem;
      opacity: 0.92;
      margin-top: 3px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .badge {
      background: rgba(255, 255, 255, 0.2);
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
    }

    .btn-header {
      background: rgba(255, 255, 255, 0.95);
      color: var(--primary);
      border: none;
      padding: 7px 14px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-header:hover {
      background: #ffffff;
      transform: translateY(-1px);
    }

    .content {
      padding: 28px;
    }

    /* Layar Awal */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin: 14px 0 22px;
    }

    .info-box {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      background: #f8fafc;
      text-align: center;
    }

    .info-box strong {
      display: block;
      font-size: 1.2rem;
      color: var(--primary);
    }

    .info-box span {
      font-size: 0.82rem;
      color: var(--muted);
      font-weight: 600;
    }

    .formula-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 12px;
      margin-bottom: 22px;
    }

    .formula-card {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
    }

    .formula-card h3 {
      color: var(--primary);
      font-size: 0.96rem;
      margin-bottom: 6px;
    }

    .formula-card ul {
      list-style: none;
      font-size: 0.82rem;
      line-height: 1.65;
    }

    .form-row {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 14px;
      margin-bottom: 18px;
    }

    @media (max-width: 600px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .input-group label {
      font-weight: 600;
      font-size: 0.9rem;
    }

    .input-group input {
      padding: 11px 14px;
      border: 2px solid var(--border);
      border-radius: 12px;
      font-size: 0.98rem;
      outline: none;
    }

    .input-group input:focus {
      border-color: var(--primary);
    }

    .btn {
      background: var(--primary);
      color: white;
      border: none;
      padding: 12px 22px;
      border-radius: 12px;
      font-size: 0.96rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn:hover:not(:disabled) {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-outline {
      background: #ffffff;
      color: var(--primary);
      border: 2px solid var(--primary);
    }

    .btn-outline:hover:not(:disabled) {
      background: #eff6ff;
    }

    .btn-success {
      background: var(--success);
    }

    .btn-success:hover:not(:disabled) {
      background: #166534;
    }

    .btn-danger {
      background: var(--danger);
    }

    .btn-danger:hover:not(:disabled) {
      background: #991b1b;
    }

    /* Layar Kuis */
    .quiz-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tags-wrapper {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .topic-tag {
      background: #e2e8f0;
      color: #1e293b;
      font-weight: 600;
      font-size: 0.8rem;
      padding: 5px 12px;
      border-radius: 8px;
    }

    .level-tag {
      font-weight: 700;
      font-size: 0.78rem;
      padding: 5px 12px;
      border-radius: 8px;
      text-transform: uppercase;
    }

    .level-mudah { background: var(--easy-bg); color: var(--easy-text); }
    .level-sedang { background: var(--med-bg); color: var(--med-text); }
    .level-kontekstual { background: var(--ctx-bg); color: var(--ctx-text); }
    .level-hots { background: var(--hots-bg); color: var(--hots-text); }

    .timer-box {
      font-weight: 700;
      font-size: 0.95rem;
      background: #f1f5f9;
      padding: 6px 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .timer-box.warning {
      color: var(--danger);
      background: var(--danger-bg);
      border-color: #fca5a5;
    }

    .progress-bar {
      width: 100%;
      height: 8px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 22px;
    }

    .progress-fill {
      height: 100%;
      background: var(--primary);
      width: 0%;
      transition: width 0.3s ease;
    }

    .question-box {
      display: grid;
      grid-template-columns: 1fr 210px;
      gap: 20px;
      align-items: center;
      margin-bottom: 20px;
    }

    @media (max-width: 680px) {
      .question-box {
        grid-template-columns: 1fr;
      }
    }

    .question-text {
      font-size: 1.05rem;
      line-height: 1.65;
      font-weight: 600;
      color: var(--secondary);
    }

    .illustration-box {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .options-list {
      display: flex;
      flex-direction: column;
      gap: 11px;
    }

    .option-btn {
      width: 100%;
      text-align: left;
      background: #ffffff;
      border: 2px solid var(--border);
      border-radius: 12px;
      padding: 13px 16px;
      font-size: 0.96rem;
      color: var(--text);
      cursor: pointer;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .option-btn:hover:not(:disabled) {
      border-color: var(--primary-light);
      background: #f8fafc;
    }

    .option-letter {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: #f1f5f9;
      color: var(--secondary);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .option-btn.correct {
      border-color: var(--success);
      background: var(--success-bg);
      color: #14532d;
    }

    .option-btn.correct .option-letter {
      background: var(--success);
      color: white;
    }

    .option-btn.wrong {
      border-color: var(--danger);
      background: var(--danger-bg);
      color: #7f1d1d;
    }

    .option-btn.wrong .option-letter {
      background: var(--danger);
      color: white;
    }

    .explanation-box {
      margin-top: 18px;
      padding: 16px;
      border-radius: 12px;
      background: #eff6ff;
      border-left: 4px solid var(--primary);
      font-size: 0.92rem;
      line-height: 1.6;
      display: none;
    }

    .explanation-box h4 {
      color: var(--primary);
      margin-bottom: 4px;
    }

    .quiz-footer {
      margin-top: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* Layar Hasil & Rangkuman Nilai */
    .result-header {
      text-align: center;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }

    .score-circle {
      width: 115px;
      height: 115px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin: 0 auto 14px;
      box-shadow: 0 10px 20px rgba(30, 64, 175, 0.25);
    }

    .score-circle span {
      font-size: 2.1rem;
      font-weight: 800;
      line-height: 1;
    }

    .score-circle small {
      font-size: 0.76rem;
      margin-top: 4px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin: 18px 0;
    }

    .stat-card {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      text-align: center;
    }

    .stat-card strong {
      display: block;
      font-size: 1.25rem;
    }

    .stat-card span {
      font-size: 0.8rem;
      color: var(--muted);
    }

    /* Tabel Rangkuman Nilai Peserta */
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 12px;
      margin: 14px 0 22px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
      text-align: left;
    }

    th {
      background: #f1f5f9;
      color: var(--secondary);
      font-weight: 700;
      padding: 12px 14px;
      border-bottom: 2px solid var(--border);
      white-space: nowrap;
    }

    td {
      padding: 11px 14px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: #f8fafc;
    }

    .pill-status {
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 700;
      display: inline-block;
    }

    .pill-tuntas {
      background: var(--success-bg);
      color: var(--success);
    }

    .pill-remedial {
      background: var(--danger-bg);
      color: var(--danger);
    }

    .review-list {
      margin-top: 12px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 360px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .review-item {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      font-size: 0.9rem;
    }

    .review-item.is-correct { border-left: 4px solid var(--success); }
    .review-item.is-wrong { border-left: 4px solid var(--danger); }

    .section-header-flex {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 10px;
    }

    .hidden { display: none !important; }
  </style>
</head>
<body>
  <div class="app-container">
    <div class="header">
      <div>
        <h1>Kuis Matematika: Bangun Ruang Sisi Tegak</h1>
        <p>SMP Kelas 9 &bull; Kubus, Balok, Prisma, dan Limas (20 Soal)</p>
      </div>
      <div class="header-actions">
        <div class="badge" id="headerBadge">KKM: 75</div>
        <button class="btn-header" id="openScoreboardBtn">&#128202; Rekap Nilai (<span id="participantCountBadge">0</span>)</button>
      </div>
    </div>

    <!-- SCREEN 1: MULAI -->
    <div class="content" id="startScreen">
      <h2 style="font-size: 1.12rem;">Komposisi 20 Soal Evaluasi</h2>
      <div class="info-grid">
        <div class="info-box"><strong>5 Soal</strong><span>Mudah (Dasar)</span></div>
        <div class="info-box"><strong>10 Soal</strong><span>Sedang (Aplikasi)</span></div>
        <div class="info-box"><strong>3 Soal</strong><span>Kontekstual</span></div>
        <div class="info-box"><strong>2 Soal</strong><span>HOTS (Penalaran)</span></div>
      </div>

      <h3 style="font-size: 1rem; margin-bottom: 10px;">Ringkasan Rumus Bangun Ruang Sisi Tegak</h3>
      <div class="formula-cards">
        <div class="formula-card">
          <h3>Kubus (rusuk = s)</h3>
          <ul>
            <li>Panjang Rusuk = 12s</li>
            <li>Luas Permukaan = 6s&sup2;</li>
            <li>Volume = s&sup3;</li>
          </ul>
        </div>
        <div class="formula-card">
          <h3>Balok (p, l, t)</h3>
          <ul>
            <li>Panjang Rusuk = 4(p + l + t)</li>
            <li>L. Permukaan = 2(pl + pt + lt)</li>
            <li>Volume = p &times; l &times; t</li>
          </ul>
        </div>
        <div class="formula-card">
          <h3>Prisma</h3>
          <ul>
            <li>L. Permukaan = (2 &times; L.Alas) + (K.Alas &times; t)</li>
            <li>Volume = L.Alas &times; t</li>
          </ul>
        </div>
        <div class="formula-card">
          <h3>Limas</h3>
          <ul>
            <li>L. Permukaan = L.Alas + &Sigma;L.Sisi Tegak</li>
            <li>Volume = 1/3 &times; L.Alas &times; t</li>
          </ul>
        </div>
      </div>

      <div class="form-row">
        <div class="input-group">
          <label for="studentName">Nama Lengkap Peserta:</label>
          <input type="text" id="studentName" placeholder="Contoh: Budi Santoso" autocomplete="off" />
        </div>
        <div class="input-group">
          <label for="studentClass">Kelas:</label>
          <input type="text" id="studentClass" placeholder="Contoh: IX-A" autocomplete="off" />
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span style="font-size: 0.88rem; color: var(--muted);">Waktu: <strong>30 Menit</strong> &bull; Bobot: <strong>5 poin/soal</strong></span>
        <button class="btn" id="startBtn">Mulai Mengerjakan &rarr;</button>
      </div>
    </div>

    <!-- SCREEN 2: KUIS -->
    <div class="content hidden" id="quizScreen">
      <div class="quiz-meta">
        <div class="tags-wrapper">
          <span class="level-tag level-mudah" id="levelBadge">MUDAH</span>
          <span class="topic-tag" id="questionTopic">Topik: Kubus</span>
        </div>
        <span style="font-weight: 600; font-size: 0.92rem;" id="questionCounter">Soal 1 dari 20</span>
        <div class="timer-box" id="timerDisplay">30:00</div>
      </div>

      <div class="progress-bar">
        <div class="progress-fill" id="progressFill"></div>
      </div>

      <div class="question-box">
        <div class="question-text" id="questionText">Memuat soal...</div>
        <div class="illustration-box" id="illustrationBox"></div>
      </div>

      <div class="options-list" id="optionsContainer"></div>

      <div class="explanation-box" id="explanationBox">
        <h4>Pembahasan Langkah demi Langkah:</h4>
        <p id="explanationText"></p>
      </div>

      <div class="quiz-footer">
        <div style="font-size: 0.9rem; color: var(--muted);">
          Skor sementara: <strong id="liveScore" style="color: var(--primary);">0</strong> / 100
        </div>
        <button class="btn" id="nextBtn" disabled>Soal Berikutnya &rarr;</button>
      </div>
    </div>

    <!-- SCREEN 3: HASIL INDIVIDU + RANGKUMAN NILAI PESERTA -->
    <div class="content hidden" id="resultScreen">
      <div class="result-header">
        <div class="score-circle">
          <span id="finalScore">0</span>
          <small>NILAI AKHIR</small>
        </div>
        <h2 id="resultGreeting">Selesai!</h2>
        <p id="resultSubtitle" style="color: var(--muted); font-size: 0.95rem; margin-top: 4px;"></p>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <strong id="correctCount" style="color: var(--success);">0 / 20</strong>
          <span>Total Benar</span>
        </div>
        <div class="stat-card">
          <strong id="breakdownScore" style="font-size: 0.95rem; color: var(--primary); padding-top: 4px;">-</strong>
          <span>Rincian Benar per Kategori</span>
        </div>
        <div class="stat-card">
          <strong id="timeTaken">00:00</strong>
          <span>Durasi Pengerjaan</span>
        </div>
      </div>

      <!-- RANGKUMAN NILAI SETIAP PESERTA -->
      <div class="section-header-flex">
        <h3 style="font-size: 1.05rem;">Rangkuman Nilai Semua Peserta</h3>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn btn-success" style="padding: 8px 14px; font-size: 0.84rem;" id="exportCsvBtn">&#128190; Unduh Excel (CSV)</button>
          <button class="btn btn-danger" style="padding: 8px 14px; font-size: 0.84rem;" id="clearDataBtn">&#128465; Hapus Data</button>
        </div>
      </div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>No</th>
              <th>Nama Peserta</th>
              <th>Kelas</th>
              <th>Mudah (5)</th>
              <th>Sedang (10)</th>
              <th>Kontekstual (3)</th>
              <th>HOTS (2)</th>
              <th>Nilai</th>
              <th>Status</th>
              <th>Waktu</th>
            </tr>
          </thead>
          <tbody id="scoreboardTableBody"></tbody>
        </table>
      </div>

      <h3 style="font-size: 1.05rem; margin-bottom: 8px;">Ulasan & Pembahasan 20 Soal</h3>
      <div class="review-list" id="reviewList"></div>

      <div style="margin-top: 22px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <button class="btn" id="restartBtn">&#10133; Peserta Berikutnya / Ulangi Kuis</button>
      </div>
    </div>

    <!-- SCREEN 4: HALAMAN KHUSUS REKAP NILAI (DARI TOMBOL HEADER) -->
    <div class="content hidden" id="scoreboardScreen">
      <div class="section-header-flex" style="margin-top: 0; margin-bottom: 14px;">
        <div>
          <h2 style="font-size: 1.2rem;">Rangkuman Nilai Setiap Peserta</h2>
          <p style="font-size: 0.86rem; color: var(--muted);">Data tersimpan otomatis di browser perangkat ini.</p>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button class="btn btn-success" style="padding: 8px 14px; font-size: 0.84rem;" id="exportCsvBtn2">&#128190; Unduh Excel (CSV)</button>
          <button class="btn btn-danger" style="padding: 8px 14px; font-size: 0.84rem;" id="clearDataBtn2">&#128465; Reset Data</button>
          <button class="btn btn-outline" style="padding: 8px 14px; font-size: 0.84rem;" id="backToStartBtn">&larr; Kembali</button>
        </div>
      </div>

      <div class="stats-grid" id="classSummaryStats"></div>

      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>No</th>
              <th>Nama Peserta</th>
              <th>Kelas</th>
              <th>Mudah (5)</th>
              <th>Sedang (10)</th>
              <th>Kontekstual (3)</th>
              <th>HOTS (2)</th>
              <th>Nilai</th>
              <th>Status</th>
              <th>Durasi</th>
            </tr>
          </thead>
          <tbody id="scoreboardTableBody2"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    // Ilustrasi SVG Bangun Ruang Sisi Tegak
    const svgs = {
      kubus: (label) => `
        <svg width="150" height="135" viewBox="0 0 150 135">
          <rect x="30" y="42" width="68" height="68" fill="#eff6ff" stroke="#1e40af" stroke-width="2"/>
          <polygon points="30,42 56,20 124,20 98,42" fill="#dbeafe" stroke="#1e40af" stroke-width="2"/>
          <polygon points="98,42 124,20 124,88 98,110" fill="#bfdbfe" stroke="#1e40af" stroke-width="2"/>
