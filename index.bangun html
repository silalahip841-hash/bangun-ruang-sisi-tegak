        id: Date.now(),
        nama: studentName,
        kelas: studentClass,
        mudah: mudahBenar,
        sedang: sedangBenar,
        kontekstual: kontekstualBenar,
        hots: hotsBenar,
        benarTotal: correctTotal,
        nilai: score,
        status: score >= KKM ? "Tuntas" : "Remedial",
        durasi: durationStr,
        waktuSelesai: new Date().toLocaleString("id-ID")
      });

      document.getElementById("finalScore").textContent = score;
      document.getElementById("correctCount").textContent = `${correctTotal} / 20`;
      document.getElementById("breakdownScore").textContent = `M:${mudahBenar}/5 | S:${sedangBenar}/10 | K:${kontekstualBenar}/3 | H:${hotsBenar}/2`;
      document.getElementById("timeTaken").textContent = durationStr;

      let predicate = "";
      if (score >= 90) predicate = `Sangat Memuaskan, ${studentName} (${studentClass})! Penguasaan konsep dasar hingga HOTS sangat baik.`;
      else if (score >= 75) predicate = `Tuntas! Bagus sekali, ${studentName} (${studentClass}). Pemahaman materi Bangun Ruang Sisi Tegak sudah baik.`;
      else predicate = `Belum Tuntas (KKM 75), ${studentName} (${studentClass}). Pelajari kembali pembahasan di bawah ini.`;

      document.getElementById("resultGreeting").textContent = score >= KKM ? "Selamat, Tuntas!" : "Kuis Selesai!";
      document.getElementById("resultSubtitle").textContent = predicate;

      renderScoreboardTables();

      const reviewList = document.getElementById("reviewList");
      reviewList.innerHTML = "";

      questions.forEach((q, idx) => {
        const ans = userAnswers[idx];
        const statusClass = ans && ans.isCorrect ? "is-correct" : "is-wrong";
        const userAnsText = ans ? ans.selected : "Tidak dijawab (Waktu habis)";

        const item = document.createElement("div");
        item.className = `review-item ${statusClass}`;
        item.innerHTML = `
          <div style="margin-bottom: 6px;">
            <span class="level-tag ${q.levelClass}" style="font-size: 0.7rem; padding: 3px 8px; margin-right: 6px;">${q.level}</span>
            <strong>${idx + 1}. ${q.question}</strong>
          </div>
          <div style="font-size: 0.85rem; margin-bottom: 4px;">
            Jawaban Anda: <strong style="color: ${ans && ans.isCorrect ? 'var(--success)' : 'var(--danger)'}">${userAnsText}</strong>
            ${(!ans || !ans.isCorrect) ? ` | Kunci: <strong style="color: var(--success)">${q.options[q.answer]}</strong>` : ''}
          </div>
          <div style="font-size: 0.84rem; color: var(--muted); background: #f8fafc; padding: 8px; border-radius: 8px; margin-top: 6px;">
            <strong>Pembahasan:</strong> ${q.explanation}
          </div>
        `;
        reviewList.appendChild(item);
      });
    }

    function renderScoreboardTables() {
      const results = getSavedResults();
      const bodies = [
        document.getElementById("scoreboardTableBody"),
        document.getElementById("scoreboardTableBody2")
      ];

      bodies.forEach(tbody => {
        if (!tbody) return;
        tbody.innerHTML = "";

        if (results.length === 0) {
          tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; color: var(--muted); padding: 20px;">Belum ada data nilai peserta yang tersimpan.</td></tr>`;
          return;
        }

        // Urutkan berdasarkan nilai tertinggi
        const sorted = [...results].sort((a, b) => b.nilai - a.nilai);
        sorted.forEach((r, index) => {
          const pillClass = r.nilai >= KKM ? "pill-tuntas" : "pill-remedial";
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td><strong>${index + 1}</strong></td>
            <td><strong>${escapeHtml(r.nama)}</strong></td>
            <td>${escapeHtml(r.kelas)}</td>
            <td>${r.mudah} / 5</td>
            <td>${r.sedang} / 10</td>
            <td>${r.kontekstual} / 3</td>
            <td>${r.hots} / 2</td>
            <td><strong style="font-size: 1rem; color: var(--primary);">${r.nilai}</strong></td>
            <td><span class="pill-status ${pillClass}">${r.status}</span></td>
            <td>${r.durasi}</td>
          `;
          tbody.appendChild(tr);
        });
      });

      // Statistik Kelas di layar Rekap Nilai
      const summaryEl = document.getElementById("classSummaryStats");
      if (results.length === 0) {
        summaryEl.innerHTML = "";
      } else {
        const avg = (results.reduce((acc, cur) => acc + cur.nilai, 0) / results.length).toFixed(1);
        const maxScore = Math.max(...results.map(r => r.nilai));
        const tuntasCount = results.filter(r => r.nilai >= KKM).length;
        summaryEl.innerHTML = `
          <div class="stat-card"><strong style="color: var(--primary);">${results.length}</strong><span>Jumlah Peserta</span></div>
          <div class="stat-card"><strong>${avg}</strong><span>Rata-rata Nilai</span></div>
          <div class="stat-card"><strong style="color: var(--success);">${maxScore}</strong><span>Nilai Tertinggi</span></div>
          <div class="stat-card"><strong style="color: var(--success);">${tuntasCount} / ${results.length}</strong><span>Peserta Tuntas (≥75)</span></div>
        `;
      }
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function exportToCSV() {
      const results = getSavedResults();
      if (results.length === 0) {
        alert("Belum ada data peserta untuk diunduh.");
        return;
      }

      const headers = ["No", "Nama Peserta", "Kelas", "Mudah (Max 5)", "Sedang (Max 10)", "Kontekstual (Max 3)", "HOTS (Max 2)", "Total Benar", "Nilai Akhir", "Status", "Durasi", "Waktu Selesai"];
      const rows = results.map((r, i) => [
        i + 1,
        `"${r.nama.replace(/"/g, '""')}"`,
        `"${r.kelas.replace(/"/g, '""')}"`,
        r.mudah,
        r.sedang,
        r.kontekstual,
        r.hots,
        r.benarTotal,
        r.nilai,
        r.status,
        r.durasi,
        `"${r.waktuSelesai}"`
      ]);

      const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `Rekap_Nilai_Kuis_BRST_Kelas9.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function clearAllResults() {
      if (confirm("Apakah Anda yakin ingin menghapus seluruh rangkuman nilai peserta?")) {
        localStorage.removeItem(STORAGE_KEY);
        updateParticipantCountBadge();
        renderScoreboardTables();
      }
    }

    // Event Listeners Navigasi & Ekspor
    document.getElementById("openScoreboardBtn").addEventListener("click", () => {
      clearInterval(timerInterval);
      renderScoreboardTables();
      showScreen(scoreboardScreen);
    });

    document.getElementById("backToStartBtn").addEventListener("click", () => {
      showScreen(startScreen);
      document.getElementById("headerBadge").textContent = "KKM: 75";
    });

    restartBtn.addEventListener("click", () => {
      studentNameInput.value = "";
      showScreen(startScreen);
      document.getElementById("headerBadge").textContent = "KKM: 75";
    });

    document.getElementById("exportCsvBtn").addEventListener("click", exportToCSV);
    document.getElementById("exportCsvBtn2").addEventListener("click", exportToCSV);
    document.getElementById("clearDataBtn").addEventListener("click", clearAllResults);
    document.getElementById("clearDataBtn2").addEventListener("click", clearAllResults);
  </script>
</body>
</html>
